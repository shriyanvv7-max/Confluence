---
import { event, registration, registrationUrl } from '../data/site';
import EventCountdown from './EventCountdown.astro';
---
<section class="hero" id="top" aria-labelledby="hero-title"><div class="hero-orb" aria-hidden="true"></div><div class="hero-art" aria-hidden="true"><svg viewBox="0 0 700 700" fill="none"><defs><radialGradient id="core"><stop stop-color="#73f5ff" stop-opacity=".8"/><stop offset=".15" stop-color="#9881ff" stop-opacity=".42"/><stop offset="1" stop-color="#080a14" stop-opacity="0"/></radialGradient><filter id="glow"><feGaussianBlur stdDeviation="5" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs><circle cx="350" cy="350" r="164" fill="url(#core)"/><circle cx="350" cy="350" r="10" fill="#b9ffff" filter="url(#glow)"/><g class="art-ring" stroke="#82caff" stroke-opacity=".24"><ellipse cx="350" cy="350" rx="300" ry="94" transform="rotate(-34 350 350)"/><ellipse cx="350" cy="350" rx="275" ry="124" transform="rotate(34 350 350)"/></g><g class="art-ring reverse" stroke="#c084ff" stroke-opacity=".25"><ellipse cx="350" cy="350" rx="236" ry="160" transform="rotate(67 350 350)"/><circle cx="350" cy="350" r="205" stroke-dasharray="1 8"/></g><g class="art-line" stroke="#73f5ff" stroke-opacity=".55"><path d="M40 350h230m160 0h230M350 40v230m0 160v230"/><path d="m132 132 158 158m120 120 158 158M568 132 410 290M290 410 132 568" stroke="#ff54bd" stroke-opacity=".4"/></g><g fill="#b6faff"><circle class="art-node" cx="183" cy="196" r="3"/><circle class="art-node" cx="519" cy="233" r="2.5"/><circle class="art-node" cx="468" cy="515" r="3"/><circle class="art-node" cx="197" cy="472" r="2"/></g><path d="M350 323v54m-27-27h54" stroke="#d3e8ff" stroke-opacity=".5"/></svg></div><div class="shell hero-copy"><div class="kicker hero-eyebrow">BUILDATHON 2026 · IEEE Computer Society PESU Student Branch</div><h1 id="hero-title"><span>CONFLU</span><span class="outline-word">ENCE</span></h1><p class="hero-message">A 10-hour buildathon to make existing software work better.</p><div class="hero-actions"><a class="cta" href={registrationUrl} target="_blank" rel="noopener noreferrer">Registration <span>↗</span></a><div class="hero-date">{event.date}<br/>{event.time}<br/>PES University · Bengaluru<br/>Teams of {event.teamSize}</div></div><p class="registration-note">Registration deadline: {registration.deadline}.</p><EventCountdown /></div><div class="hero-prize shell"><span class="kicker">Cash prize</span><strong>{event.prize}</strong></div><a href="#convergence" class="scroll-cue"><span>Scroll to explore</span><i></i></a></section>


